inline static TRandomSource RANDOM_FUNC(SourceFromSeed)(uint64_t seed) {
  TRandomSource source = {0};
  RANDOM_SOURCE_FUNC(Init)(&source, &RANDOM_ENGINE_FUNC(Xoshiro, VTable), seed,
                         NULL);
  return source;
}

inline static uint64_t RANDOM_FUNC(U64)(void) {
  return RANDOM_ENTROPY_FUNC(Collect)();
}

inline static uint64_t RANDOM_FUNC(U64_FromSeed)(uint64_t seed) {
  TRandomSource source = RANDOM_FUNC(SourceFromSeed)(seed);
  uint64_t value = RANDOM_SOURCE_FUNC(NextU64)(&source);
  RANDOM_SOURCE_FUNC(Destroy)(&source);
  return value;
}

inline static uint64_t RANDOM_FUNC(RangeU64)(uint64_t minimum,
                                           uint64_t maximum) {
  TRandomSource source = RANDOM_FUNC(SourceFromSeed)(RANDOM_FUNC(U64)());
  uint64_t value =
      RANDOM_DISTRIBUTION_FUNC(U64)(&source, minimum, maximum);
  RANDOM_SOURCE_FUNC(Destroy)(&source);
  return value;
}

inline static int64_t RANDOM_FUNC(RangeI64)(int64_t minimum, int64_t maximum) {
  TRandomSource source = RANDOM_FUNC(SourceFromSeed)(RANDOM_FUNC(U64)());
  int64_t value =
      RANDOM_DISTRIBUTION_FUNC(I64)(&source, minimum, maximum);
  RANDOM_SOURCE_FUNC(Destroy)(&source);
  return value;
}

inline static double RANDOM_FUNC(F64)(void) {
  return (double)(RANDOM_FUNC(U64)() >> 11U) * 0x1.0p-53;
}

inline static bool RANDOM_FUNC(Bool)(void) {
  return (RANDOM_FUNC(U64)() & UINT64_C(1)) != 0U;
}
